# Field package build outputs (pack.ps1 / 完整打包)
# www：目录内 .gitignore 忽略构建产物，仅保留占位规则（同 jars/apk）
package/www/*
!package/www/.gitignore
package/update/
package/logs/

# Local package env (secrets / machine paths); keep env.example.txt
package/env.txt

# Scratch / debug dumps at repo root
/tmp-*.txt
/tmp-*.json

# Local IDE / editor (machine-specific)
.vscode/extensions.json
.vscode/launch.json
.vscode/settings.json
.vscode/tasks.json
